<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>target_flight_sim</name>
  <version>0.1.0</version>
  <description>Target aircraft flight simulator — publishes position/velocity along a configurable start-to-goal track</description>
  <maintainer email="bak1916@gmail.com">jekim98</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
